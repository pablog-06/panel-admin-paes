# Plantilla para desarrollo local.
# En Streamlit Community Cloud, copia estos valores en Advanced settings > Secrets.
# Nunca subas .streamlit/secrets.toml real a GitHub.

TRELLO_API_KEY = "reemplazar_con_tu_api_key"
TRELLO_TOKEN = "reemplazar_con_tu_token"

# Para Streamlit Community Cloud, deja esto en true hasta reemplazar la API local.
# En desarrollo local puede quedar false.
DISABLE_LOCAL_API = false
SERVER_ADMIN_NATIVE = true

# Cifrado local de logs y backups.
# Genera una llave con:
# py scripts\generate_encryption_key.py
DATA_ENCRYPTION_KEY = "reemplazar_con_llave_generada"

# Login del panel.
# Genera estos hashes con:
# py scripts\generate_password_hashes.py admin coordinacion
[auth.users.admin]
name = "admin"
password_hash = "reemplazar_con_hash_generado"

[auth.users.coordinacion]
name = "coordinacion"
password_hash = "reemplazar_con_hash_generado"

